# === Database ===
DATABASE_URL=postgresql+asyncpg://prophitbet:prophitbet@localhost:5432/prophitbet
DATABASE_URL_SYNC=postgresql://prophitbet:prophitbet@localhost:5432/prophitbet

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Auth ===
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === API rate limiting ===
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=86400

# === OAuth (optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...

# === S3 / MinIO ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=prophitbet

# === Qdrant vector store ===
# Docker Compose overrides this with http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333

# === Factual fixtures/results provider (optional but recommended) ===
# Free tokens are available from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# API-Football/API-Sports: fixtures, results, live data and observed odds.
API_FOOTBALL_KEY=

# === Frontend ===
FRONTEND_URL=http://localhost:3000

# === ML Core ===
ML_CORE_PATH=../../src
