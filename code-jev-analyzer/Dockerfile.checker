FROM node:22-alpine
WORKDIR /checker
COPY code-jev-analyzer/checker-runtime/package.json code-jev-analyzer/checker-runtime/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY code-jev-analyzer/scripts/system-checker.mjs ./system-checker.mjs
COPY code-jev-analyzer/scripts/checker-validation.mjs ./checker-validation.mjs
RUN mkdir /state && chown node:node /state
USER node
CMD ["node", "system-checker.mjs"]
